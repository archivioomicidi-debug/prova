@font-face { font-family: 'Nunito'; font-style: normal; font-weight: 400 800; font-display: swap; src: url('{{ 'gac-nunito.woff2' | asset_url }}') format('woff2'); }
@font-face { font-family: 'Pacifico'; font-style: normal; font-weight: 400; font-display: swap; src: url('{{ 'gac-pacifico-400.woff2' | asset_url }}') format('woff2'); }
@font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 400 700; font-display: swap; src: url('{{ 'gac-fraunces-normal.woff2' | asset_url }}') format('woff2'); }
@font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 400 700; font-display: swap; src: url('{{ 'gac-fraunces-italic.woff2' | asset_url }}') format('woff2'); }
/* ==========================================================
   Grazie al Cactus · design 2
   Bianco caldo, fasce colorate morbide, titoli Fraunces con
   corsivo, corpo Nunito, foto con bordi organici.
   ========================================================== */

:root {
  --green: #3f8a35; --green-dark: #27571f; --green-soft: #e4f1de;
  --coral: #e0512f; --coral-dark: #b93c1f;
  --sun: #f5b53a; --sun-soft: #fff1d3;
  --pink: #d64d8f; --pink-soft: #fbe2ee;
  --blue: #4f9ad6; --blue-soft: #e2f0fb;
  --wa: #25d366; --wa-ink: #073b1c;
  --ink: #23221f; --ink-soft: #625e56; --line: rgba(35, 34, 31, .1);
  --bg: #fffdf8; --sand: #f7f0e2; --white: #fff;
  --r: 20px; --r-lg: 28px;
  --shadow: 0 8px 24px rgba(35, 34, 31, .08); --shadow-lg: 0 24px 60px rgba(35, 34, 31, .16);
  --max: 1160px; --pad: clamp(1rem, 4vw, 2rem);
  --focus: 0 0 0 3px rgba(63, 138, 53, .35);
}

* { box-sizing: border-box; }
[hidden] { display: none !important; }
html { scroll-behavior: smooth; scroll-padding-top: 84px; overflow-x: clip; }
body { margin: 0; overflow-x: clip; background: var(--bg); color: var(--ink); font-family: "Nunito", system-ui, sans-serif; line-height: 1.6; -webkit-font-smoothing: antialiased; }
img { display: block; max-width: 100%; height: auto; }
a { color: var(--coral-dark); }
h1, h2, h3 { font-family: "Fraunces", Georgia, serif; font-weight: 600; line-height: 1.1; margin: 0 0 .5em; letter-spacing: -.01em; text-wrap: balance; }
h1 em, h2 em { font-style: italic; font-weight: 500; color: var(--green-dark); }
h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
h2 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); }
h3 { font-size: 1.2rem; }
p { margin: 0 0 1em; }
.muted { color: var(--ink-soft); }
.fine { font-size: .85rem; color: var(--ink-soft); margin: 0; }
.kicker { text-transform: uppercase; letter-spacing: .14em; font-size: .76rem; font-weight: 800; color: var(--coral); margin: 0 0 .9em; }
.kicker-light { color: var(--sun); }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
:focus-visible { outline: 0; box-shadow: var(--focus); border-radius: 6px; }
.skip { position: absolute; left: 1rem; top: -4rem; z-index: 100; padding: .6rem 1rem; background: var(--ink); color: var(--white); border-radius: 8px; font-weight: 700; text-decoration: none; }
.skip:focus { top: 1rem; }
.wrap { max-width: var(--max); margin: 0 auto; padding-left: var(--pad); padding-right: var(--pad); }
main > section { padding-top: clamp(3.5rem, 8vw, 6rem); padding-bottom: clamp(3.5rem, 8vw, 6rem); }
.section-head { max-width: 680px; margin-bottom: clamp(1.8rem, 4vw, 2.8rem); }
.section-head .muted { font-size: 1.05rem; }

/* Icone in riquadro */
.ico { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 16px; background: var(--i-soft, var(--green-soft)); flex: none; }
.ico svg { width: 30px; height: 30px; fill: none; stroke: var(--i-ink, var(--green-dark)); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.ico-green { --i-soft: var(--green-soft); --i-ink: var(--green-dark); }
.ico-sun { --i-soft: var(--sun-soft); --i-ink: #8a5a00; }
.ico-pink { --i-soft: var(--pink-soft); --i-ink: #9c2466; }
.ico-blue { --i-soft: var(--blue-soft); --i-ink: #1f5f8f; }
.ico-coral { --i-soft: #fde4dc; --i-ink: var(--coral-dark); }

/* ---------- Header ---------- */
.top { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .7rem var(--pad); background: rgba(255, 253, 248, .9); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
.brand { display: flex; align-items: center; gap: .55rem; text-decoration: none; color: var(--ink); }
.brand-name { font-family: "Pacifico", cursive; font-size: 1.35rem; color: var(--coral); line-height: 1; padding-top: .2rem; }
.brand-name em { font-style: normal; color: var(--green-dark); }
.nav { display: flex; gap: clamp(.6rem, 2vw, 1.5rem); align-items: center; }
.nav a { text-decoration: none; color: var(--ink); font-weight: 700; font-size: .93rem; padding: .3rem 0; border-bottom: 2px solid transparent; }
.nav a:hover { border-bottom-color: var(--coral); }
.nav-cta { background: var(--ink); color: var(--white) !important; padding: .5rem 1.1rem; border-radius: 999px; border: 0 !important; }
.nav-cta:hover { background: var(--coral-dark); }
.nav-toggle { display: none; }
@media (max-width: 800px) {
  .nav-toggle { display: grid; gap: 5px; width: 44px; height: 44px; place-content: center; background: transparent; border: 0; cursor: pointer; margin-left: auto; }
  .nav-toggle span { display: block; width: 22px; height: 2px; background: var(--ink); transition: transform .2s, opacity .2s; }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .nav { display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; align-items: stretch; gap: 0; background: var(--bg); border-bottom: 1px solid var(--line); box-shadow: var(--shadow); padding: .5rem 1rem 1rem; }
  .nav.is-open { display: flex; }
  .nav a { padding: .8rem .4rem; font-size: 1.05rem; border-bottom: 1px solid var(--line); }
  .nav-cta { margin-top: .8rem; text-align: center; }
}

/* ---------- Bottoni ---------- */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .85rem 1.5rem; border-radius: 999px; min-height: 46px; font: inherit; font-weight: 800; text-decoration: none; border: 2px solid transparent; cursor: pointer; transition: transform .15s, background .15s, box-shadow .15s; }
.btn:active { transform: translateY(1px); }
.btn-primary { background: var(--coral); color: var(--white); box-shadow: 0 10px 24px rgba(224, 81, 47, .28); }
.btn-primary:hover { background: var(--coral-dark); }
.btn-ghost { background: transparent; color: var(--ink); border-color: var(--ink); }
.btn-ghost:hover { background: var(--ink); color: var(--white); }
.btn-wa { background: var(--wa); color: var(--wa-ink); box-shadow: 0 10px 24px rgba(37, 211, 102, .28); }
.btn-wa:hover { background: #1fc95b; }
.btn-sm { padding: .6rem 1rem; font-size: .88rem; min-height: 40px; }
.btn-full { width: 100%; }
.actions { display: flex; flex-wrap: wrap; gap: .8rem; }

/* ---------- Hero ---------- */
.hero { max-width: var(--max); margin: 0 auto; padding-left: var(--pad); padding-right: var(--pad); display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
.hero h1 { font-size: clamp(2.1rem, 4.6vw, 3.4rem); }
.hero .lead { font-size: 1.15rem; color: var(--ink-soft); max-width: 44ch; }
.hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.6rem; }
.how { list-style: none; margin: 2.2rem 0 0; padding: 1.2rem 0 0; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: .7rem 1.6rem; }
.how li { display: flex; align-items: center; gap: .6rem; font-size: .92rem; color: var(--ink-soft); }
.how strong { color: var(--ink); }
.how-n { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--green-soft); color: var(--green-dark); font-weight: 800; font-size: .8rem; flex: none; }
.hero-visual { position: relative; aspect-ratio: 1 / 1.05; }
.blob { position: absolute; overflow: hidden; box-shadow: var(--shadow-lg); }
.blob img { width: 100%; height: 100%; object-fit: cover; }
.blob-main { inset: 0 8% 8% 0; border-radius: 58% 42% 52% 48% / 52% 46% 54% 48%; }
.blob-main img { object-position: center 20%; }
.blob-small { width: 44%; aspect-ratio: 3 / 4; right: 0; bottom: 0; border-radius: 48% 52% 44% 56% / 55% 45% 55% 45%; border: 6px solid var(--bg); }
.hero-visual::before { content: ""; position: absolute; width: 40%; aspect-ratio: 1; right: -6%; top: -4%; border-radius: 50%; background: var(--sun); opacity: .55; z-index: -1; }
.hero-visual::after { content: ""; position: absolute; width: 30%; aspect-ratio: 1; left: -6%; bottom: 8%; border-radius: 50%; background: var(--pink); opacity: .3; z-index: -1; }
.hero-badge { position: absolute; left: 0; bottom: 6%; background: var(--white); border-radius: 999px; padding: .55rem 1rem; box-shadow: var(--shadow); font-size: .88rem; font-weight: 700; color: var(--ink-soft); white-space: nowrap; }
.hero-badge strong { color: var(--green-dark); font-size: 1.05rem; }
@media (max-width: 860px) { .hero { grid-template-columns: 1fr; } .hero-visual { max-width: 380px; order: -1; } }

/* ---------- Fasce ---------- */
.band { padding-left: 0; padding-right: 0; }
.band-green { background: var(--green-soft); }
.band-sand { background: var(--sand); }
.band-deep { background: var(--green-dark); color: var(--white); }

/* ---------- LattaViva ---------- */
.manifesto { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
.manifesto-text p { font-size: 1.08rem; color: var(--ink-soft); }
.manifesto-text strong { color: var(--ink); }
.found-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
.found { display: flex; gap: 1rem; align-items: flex-start; background: var(--white); border-radius: var(--r); padding: 1.1rem 1.2rem; box-shadow: var(--shadow); }
.found h3 { font-size: 1.1rem; margin: .15rem 0 .1rem; }
.found p { margin: 0; color: var(--ink-soft); font-size: .93rem; }
.philosophy { grid-column: 1 / -1; margin: .5rem 0 0; position: relative; background: var(--white); border-radius: var(--r-lg); padding: clamp(1.8rem, 4vw, 2.8rem) clamp(1.6rem, 4vw, 3rem); box-shadow: var(--shadow); font-family: "Fraunces", Georgia, serif; font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.65; }
.philosophy::before { content: "“"; position: absolute; left: clamp(1rem, 3vw, 2rem); top: -.1em; font-size: 7rem; line-height: 1; color: var(--sun); opacity: .6; font-family: "Fraunces", serif; }
.philosophy p { margin: 0 0 .8em; position: relative; }
.philosophy p:last-child { margin: 0; color: var(--ink-soft); font-style: italic; }
.philosophy-title { font-family: "Nunito", sans-serif; text-transform: uppercase; letter-spacing: .14em; font-size: .76rem; font-weight: 800; color: var(--coral); }
@media (max-width: 860px) { .manifesto { grid-template-columns: 1fr; } }

/* ---------- Entra, guarda, scegli ---------- */
.invite { max-width: var(--max); margin: 0 auto; padding-left: var(--pad); padding-right: var(--pad); padding-top: clamp(2.5rem, 6vw, 4rem) !important; padding-bottom: 0 !important; text-align: center; }
.invite-steps { list-style: none; margin: 0 auto; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.4rem; max-width: 860px; }
.invite-steps li { display: grid; justify-items: center; gap: .2rem; }
.invite-steps svg { width: 50px; height: 50px; fill: none; stroke: var(--green-dark); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; color: var(--green-dark); margin-bottom: .3rem; }
.invite-steps strong { font-family: "Fraunces", serif; font-style: italic; font-weight: 500; font-size: 1.7rem; color: var(--coral); }
.invite-steps span { color: var(--ink-soft); font-size: .95rem; max-width: 26ch; }

/* ---------- I pezzi ---------- */
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.6rem; }
.card { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s; }
.card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.card.is-linked { outline: 3px solid var(--sun); }
.card-media { display: block; width: 100%; padding: 0; border: 0; background: var(--sand); cursor: zoom-in; position: relative; }
.card-media img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
.tag { position: absolute; top: .9rem; left: .9rem; font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--ink); background: rgba(255, 255, 255, .92); padding: .3rem .7rem; border-radius: 999px; backdrop-filter: blur(4px); }
.card-body { padding: 1.2rem 1.3rem 1.3rem; display: flex; flex-direction: column; gap: .6rem; flex: 1; }
.card-head { display: flex; justify-content: space-between; align-items: baseline; gap: .8rem; }
.card-head h3 { margin: 0; font-size: 1.3rem; }
.price { font-family: "Fraunces", serif; font-weight: 600; font-size: 1.25rem; color: var(--green-dark); white-space: nowrap; }
.price-ask { font-family: "Nunito", sans-serif; font-size: .85rem; color: var(--ink-soft); }
.card-body p { color: var(--ink-soft); font-size: .95rem; margin: 0; flex: 1; }
.card.is-sold .card-media img { filter: grayscale(.7) opacity(.7); }
.sold-badge, .sold-label { font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; padding: .35rem .7rem; border-radius: 999px; background: var(--ink); color: var(--white); }
.sold-badge { position: absolute; top: .9rem; right: .9rem; }
.sold-label { align-self: flex-start; }

/* ---------- Su misura ---------- */
.facts { list-style: none; margin: 0 0 1.8rem; padding: 0; display: flex; flex-wrap: wrap; gap: .7rem 1rem; }
.facts li { display: inline-flex; align-items: center; gap: .55rem; background: var(--white); border-radius: 999px; padding: .5rem 1rem .5rem .7rem; box-shadow: var(--shadow); font-size: .9rem; color: var(--ink-soft); }
.facts svg { width: 22px; height: 22px; fill: none; stroke: var(--green-dark); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
.facts strong { color: var(--ink); }
.wizard { background: var(--white); border-radius: var(--r-lg); box-shadow: var(--shadow); padding: clamp(1.2rem, 3vw, 2.2rem); display: grid; gap: 2rem; }
.wstep { border: 0; padding: 0; margin: 0; }
.wstep legend { display: flex; align-items: center; gap: .7rem; font-family: "Fraunces", serif; font-weight: 600; font-size: 1.3rem; margin-bottom: 1rem; }
.wnum { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--coral); color: var(--white); font-family: "Nunito", sans-serif; font-size: .9rem; font-weight: 800; }
.picks { display: grid; grid-template-columns: repeat(4, 1fr); gap: .8rem; }
.pick { position: relative; }
.pick input { position: absolute; opacity: 0; width: 0; height: 0; }
.pick-box { display: grid; gap: .15rem; height: 100%; border: 2px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--bg); cursor: pointer; padding-bottom: .8rem; transition: border-color .15s, transform .15s, box-shadow .15s; }
.pick-box img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; margin-bottom: .5rem; }
.pick-any { align-content: start; }
.pick-any svg { width: 100%; aspect-ratio: 4 / 3; padding: 18% 30%; box-sizing: border-box; fill: none; stroke: var(--green); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; background: var(--green-soft); margin-bottom: .5rem; }
.pick-label { font-weight: 800; font-size: .92rem; padding: 0 .8rem; }
.pick-note { font-size: .78rem; color: var(--ink-soft); padding: 0 .8rem; }
.pick-box:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
.pick input:checked + .pick-box { border-color: var(--green); box-shadow: 0 0 0 3px var(--green-soft); }
.pick input:checked + .pick-box .pick-label::after { content: " ✓"; color: var(--green-dark); }
.pick input:focus-visible + .pick-box { box-shadow: var(--focus); }
@media (max-width: 720px) { .picks { grid-template-columns: repeat(2, 1fr); } }
.idea-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.idea-grid label:first-child { grid-column: 1 / -1; }
.wizard label { display: grid; gap: .35rem; font-weight: 700; font-size: .95rem; }
.wizard label small { font-weight: 400; color: var(--ink-soft); }
.wizard input[type="text"], .wizard textarea { font: inherit; padding: .8rem .95rem; border-radius: 12px; width: 100%; resize: vertical; border: 1.5px solid rgba(35, 34, 31, .18); background: var(--bg); color: var(--ink); }
.wizard input:focus, .wizard textarea:focus { outline: 0; box-shadow: var(--focus); border-color: var(--green); }
.wizard [aria-invalid="true"] { border-color: var(--coral-dark); }
.field-error { font-weight: 600; font-size: .85rem; color: var(--coral-dark); }
@media (max-width: 640px) { .idea-grid { grid-template-columns: 1fr; } }
.wizard-foot { border-top: 1px solid var(--line); padding-top: 1.4rem; display: grid; gap: .9rem; }
.wizard-summary { margin: 0; font-weight: 700; color: var(--green-dark); }

/* ---------- Come nascono ---------- */
.timeline { list-style: none; margin: 0; padding: 0; position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
.timeline::before { content: ""; position: absolute; left: 12.5%; right: 12.5%; top: 36px; height: 2px; background: repeating-linear-gradient(90deg, var(--green) 0 8px, transparent 8px 16px); }
.step { position: relative; text-align: center; padding: 0 .4rem; }
.step-icon { position: relative; width: 72px; height: 72px; margin: 0 auto 1.1rem; border-radius: 50%; background: var(--white); border: 2px solid var(--green); display: grid; place-items: center; box-shadow: var(--shadow); }
.step-icon svg { width: 40px; height: 40px; fill: none; stroke: var(--green-dark); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.step-n { position: absolute; top: -6px; right: -6px; width: 26px; height: 26px; border-radius: 50%; background: var(--coral); color: var(--white); font-size: .8rem; font-weight: 800; display: grid; place-items: center; border: 2px solid var(--bg); }
.step h3 { font-size: 1.3rem; margin-bottom: .4rem; }
.step p { color: var(--ink-soft); font-size: .95rem; margin: 0 0 .7rem; }
.step-note { display: inline-block; font-size: .74rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--green-dark); background: var(--green-soft); padding: .3rem .7rem; border-radius: 999px; }
@media (max-width: 900px) {
  .timeline { grid-template-columns: 1fr; gap: 0; }
  .timeline::before { display: none; }
  .step:not(:last-child)::before { content: ""; position: absolute; left: 35px; top: 72px; bottom: 0; width: 2px; background: repeating-linear-gradient(180deg, var(--green) 0 8px, transparent 8px 16px); }
  .step { text-align: left; display: grid; grid-template-columns: 72px 1fr; column-gap: 1.2rem; padding: 0 0 2rem; }
  .step-icon { margin: 0; grid-row: 1 / span 4; }
  .step h3, .step p, .step-note { grid-column: 2; }
  .step h3 { margin-top: .2rem; }
  .step:last-child { padding-bottom: 0; }
}

/* ---------- Cura ---------- */
.rules { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.4rem; }
.rule { background: var(--white); border-radius: var(--r); padding: 1.6rem 1.5rem 1.4rem; box-shadow: var(--shadow); display: flex; flex-direction: column; border-top: 6px solid var(--rule-color); }
.rule .ico { --i-soft: var(--rule-soft); --i-ink: var(--ink); width: 60px; height: 60px; border-radius: 50%; margin-bottom: 1rem; }
.rule-sun { --rule-color: var(--sun); --rule-soft: var(--sun-soft); }
.rule-water { --rule-color: var(--blue); --rule-soft: var(--blue-soft); }
.rule-drain { --rule-color: var(--coral); --rule-soft: #fde4dc; }
.rule h3 { font-size: 1.45rem; margin-bottom: .4rem; }
.rule p { color: var(--ink-soft); font-size: .95rem; margin: 0 0 1.1rem; flex: 1; }
.rule-facts { margin: 0; display: grid; gap: .5rem; border-top: 1px solid var(--line); padding-top: 1rem; }
.rule-facts div { display: grid; grid-template-columns: 5.2rem 1fr; gap: .6rem; font-size: .88rem; align-items: baseline; }
.rule-facts dt { font-weight: 800; text-transform: uppercase; letter-spacing: .08em; font-size: .72rem; color: var(--rule-color); filter: brightness(.75); }
.rule-facts dd { margin: 0; color: var(--ink); }

/* ---------- Domande ---------- */
.faq { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
.faq-side { position: sticky; top: 96px; }
.faq-cta { margin-top: 1.4rem; background: var(--white); border-radius: var(--r); padding: 1.1rem 1.2rem; box-shadow: var(--shadow); display: grid; grid-template-columns: 44px 1fr; gap: .6rem .9rem; align-items: center; }
.faq-cta svg { width: 44px; height: 44px; fill: none; stroke: var(--green-dark); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.faq-cta div { display: grid; line-height: 1.35; }
.faq-cta span { font-size: .9rem; color: var(--ink-soft); }
.faq-cta .btn { grid-column: 1 / -1; justify-self: start; }
@media (max-width: 860px) { .faq { grid-template-columns: 1fr; } .faq-side { position: static; } }
.faq-list { display: grid; gap: .7rem; }
.faq-list details { background: var(--white); border-radius: 16px; border: 1px solid var(--line); overflow: hidden; transition: box-shadow .15s; }
.faq-list details[open] { box-shadow: var(--shadow); border-color: transparent; }
.faq-list summary { cursor: pointer; list-style: none; display: grid; grid-template-columns: 40px 1fr 24px; align-items: center; gap: .9rem; padding: .95rem 1.1rem; font-weight: 800; }
.faq-list summary::-webkit-details-marker { display: none; }
.faq-list summary:hover { background: var(--bg); }
.faq-list .ico { width: 40px; height: 40px; border-radius: 12px; }
.faq-list .ico svg { width: 22px; height: 22px; stroke-width: 1.8; }
.faq-q { font-family: "Fraunces", serif; font-weight: 600; font-size: 1.1rem; }
.faq-chev { width: 10px; height: 10px; border-right: 2px solid var(--ink-soft); border-bottom: 2px solid var(--ink-soft); transform: rotate(45deg); transition: transform .2s; justify-self: center; margin-top: -4px; }
.faq-list details[open] .faq-chev { transform: rotate(-135deg); margin-top: 4px; }
.faq-a { padding: 0 1.1rem 1.1rem calc(1.1rem + 40px + .9rem); }
.faq-a p { margin: 0; color: var(--ink-soft); }
@media (max-width: 520px) { .faq-a { padding-left: 1.1rem; } }

/* ---------- Contatti ---------- */
.band-deep { background-image: radial-gradient(circle at 85% 15%, rgba(245, 181, 58, .28), transparent 40%), radial-gradient(circle at 10% 90%, rgba(214, 77, 143, .25), transparent 45%); }
.contact { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
.contact h2 { color: var(--white); }
.contact h2 em { color: var(--sun); }
.contact-lead { color: rgba(255, 255, 255, .82); font-size: 1.05rem; max-width: 46ch; }
.wa-card { display: grid; grid-template-columns: 56px 1fr auto; align-items: center; gap: 1rem; background: var(--white); color: var(--ink); text-decoration: none; border-radius: var(--r); padding: 1.1rem 1.3rem; box-shadow: var(--shadow-lg); margin-top: 1.4rem; transition: transform .15s; }
.wa-card:hover { transform: translateY(-2px); }
.wa-card-icon { width: 56px; height: 56px; border-radius: 50%; background: var(--wa); color: var(--wa-ink); display: grid; place-items: center; }
.wa-card-text { display: grid; line-height: 1.3; }
.wa-card-number { font-family: "Fraunces", serif; font-size: 1.5rem; font-weight: 600; color: var(--green-dark); }
.wa-card-note { font-size: .88rem; color: var(--ink-soft); }
.wa-card-arrow { font-size: 1.6rem; color: var(--green-dark); }
.contact-facts { list-style: none; margin: 1.6rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .8rem 1.6rem; }
.contact-facts li { display: inline-flex; align-items: center; gap: .5rem; font-size: .93rem; color: rgba(255, 255, 255, .9); }
.contact-facts svg { width: 22px; height: 22px; fill: none; stroke: var(--sun); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
.contact-side { background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .14); border-radius: var(--r-lg); padding: 1.4rem; }
.contact-side-title { text-transform: uppercase; letter-spacing: .12em; font-size: .76rem; font-weight: 800; color: var(--sun); margin-bottom: .9rem; }
.channels { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
.channels a { display: grid; grid-template-columns: 40px 1fr auto; align-items: center; gap: .8rem; text-decoration: none; color: var(--white); padding: .7rem .8rem; border-radius: 14px; background: rgba(255, 255, 255, .06); transition: background .15s; }
.channels a:hover { background: rgba(255, 255, 255, .16); }
.ch-icon { width: 40px; height: 40px; border-radius: 12px; background: rgba(255, 255, 255, .14); display: grid; place-items: center; }
.ch-icon svg { width: 22px; height: 22px; fill: none; stroke: var(--white); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.ch-text { display: grid; line-height: 1.3; }
.ch-text small { color: rgba(255, 255, 255, .72); font-size: .85rem; }
.ch-arrow { color: var(--sun); }
.contact-side-note { margin: 1rem 0 0; font-size: .85rem; color: rgba(255, 255, 255, .7); }
@media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
@media (max-width: 520px) { .wa-card { grid-template-columns: 48px 1fr; } .wa-card-arrow { display: none; } .wa-card-icon { width: 48px; height: 48px; } }

/* ---------- Footer ---------- */
.site-footer { background: var(--sand); padding: clamp(2.5rem, 6vw, 4rem) 0 6rem; }
.footer-grid { display: grid; grid-template-columns: 1.3fr .8fr 1.1fr; gap: 2.5rem; }
.footer-tagline { margin: 1rem 0 1.2rem; color: var(--ink-soft); max-width: 34ch; font-size: .95rem; }
.footer-social { list-style: none; margin: 0; padding: 0; display: flex; gap: .6rem; }
.footer-social a { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--white); box-shadow: var(--shadow); color: var(--green-dark); }
.footer-social a:hover { background: var(--green-dark); color: var(--white); }
.footer-social svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.footer-social svg.fill { stroke: none; }
.footer-col { display: grid; gap: .5rem; align-content: start; }
.footer-title { text-transform: uppercase; letter-spacing: .12em; font-size: .76rem; font-weight: 800; color: var(--coral); margin: 0 0 .4rem; }
.footer-col a { text-decoration: none; color: var(--ink); font-weight: 600; font-size: .95rem; }
.footer-col a:hover { color: var(--coral-dark); }
.footer-line { display: flex; align-items: center; gap: .55rem; margin: 0; font-size: .95rem; }
.footer-line svg { width: 20px; height: 20px; fill: none; stroke: var(--green); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
.footer-line-static { color: var(--ink-soft); font-weight: 400; }
.footer-bottom { margin-top: 2.5rem; padding-top: 1.4rem; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr auto; gap: .4rem 2rem; align-items: start; font-size: .82rem; color: var(--ink-soft); }
.footer-bottom p { margin: 0; grid-column: 1; }
.to-top { grid-column: 2; grid-row: 1 / span 2; align-self: center; text-decoration: none; font-weight: 800; color: var(--ink); background: var(--white); border-radius: 999px; padding: .5rem 1rem; box-shadow: var(--shadow); white-space: nowrap; }
.to-top:hover { color: var(--coral-dark); }
@media (max-width: 800px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-brand-col { grid-column: 1 / -1; } }
@media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } .footer-bottom { grid-template-columns: 1fr; } .footer-bottom p { grid-column: 1; } .to-top { grid-column: 1; grid-row: auto; justify-self: start; } }

/* ---------- Pulsante fisso e lightbox ---------- */
.fab { position: fixed; right: 1.1rem; bottom: 1.1rem; z-index: 30; width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: var(--wa); color: var(--wa-ink); box-shadow: 0 12px 30px rgba(0, 0, 0, .25); }
.fab:hover { background: #1fc95b; }
.lightbox { position: fixed; inset: 0; z-index: 50; background: rgba(20, 18, 15, .93); display: grid; grid-template-columns: 56px 1fr 56px; align-items: center; padding: 1rem 0; }
.lightbox figure { margin: 0; display: grid; justify-items: center; gap: .8rem; min-width: 0; }
.lightbox img { max-height: 82vh; max-width: min(92vw, 720px); border-radius: 16px; box-shadow: 0 30px 80px rgba(0, 0, 0, .6); }
.lightbox figcaption { color: var(--white); font-family: "Fraunces", serif; font-size: 1.2rem; }
.lightbox-close { position: absolute; top: .6rem; right: .9rem; width: 44px; height: 44px; background: transparent; border: 0; color: var(--white); font-size: 2.4rem; cursor: pointer; line-height: 1; }
.lightbox-nav { background: transparent; border: 0; color: var(--white); font-size: 3rem; line-height: 1; cursor: pointer; height: 100%; opacity: .8; }
.lightbox-nav:hover { opacity: 1; }
.lightbox :focus-visible { box-shadow: 0 0 0 3px var(--sun); }
@media (max-width: 600px) { .lightbox { grid-template-columns: 40px 1fr 40px; } .lightbox-nav { font-size: 2.2rem; } }

@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .card, .btn, .nav-toggle span, .pick-box, .wa-card { transition: none; } }

/* ---------- Carrello (Shopify) ---------- */
.cart-link { position: relative; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; color: var(--ink); text-decoration: none; background: var(--sand); flex: none; }
.cart-link:hover { background: var(--green-soft); color: var(--green-dark); }
.cart-count { position: absolute; top: -4px; right: -4px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--coral); color: var(--white); font-size: .72rem; font-weight: 800; display: grid; place-items: center; border: 2px solid var(--bg); }
.top { gap: .8rem; }
@media (max-width: 800px) { .nav-toggle { margin-left: 0; } .cart-link { margin-left: auto; } }
.card-head h3 a { color: inherit; text-decoration: none; }
.card-head h3 a:hover { color: var(--coral-dark); }
.add-form { margin: 0; }
.add-form .btn[disabled] { opacity: .7; cursor: wait; }
.toast { position: fixed; left: 50%; bottom: 5.5rem; transform: translateX(-50%); z-index: 60; background: var(--ink); color: var(--white); padding: .8rem 1.2rem; border-radius: 999px; font-weight: 700; font-size: .95rem; box-shadow: var(--shadow-lg); max-width: calc(100vw - 2rem); text-align: center; }
.toast a { color: var(--sun); }
